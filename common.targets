<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================
       ArchenaAI.Common
       Shared build policy for all ArchenaAI.Common modules.

       Imported by individual projects using:
       <Import Project="..\..\build\Common.targets" />
       ============================================================ -->

  <!-- ============================================================
       Framework / Language
       ============================================================ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <LangVersion>latest</LangVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Deterministic>true</Deterministic>
  </PropertyGroup>


  <!-- ============================================================
       Build Quality
       ============================================================ -->
  <PropertyGroup>
    <!-- Temporarily relax warnings-as-errors to allow incremental fixes after package updates -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Keep generated documentation warnings from breaking builds
         until the public API documentation baseline is complete. -->
    <NoWarn>
      $(NoWarn);
      CS1591
    </NoWarn>
  </PropertyGroup>


  <!-- ============================================================
       Versioning
       ============================================================ -->
  <PropertyGroup>
    <!-- Versioning (explicit values to avoid empty assembly attributes during build) -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Version>0.1.0</Version>
    <!-- Keep assembly identity independent from package versioning. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>


  <!-- ============================================================
       Package Metadata
       ============================================================ -->
  <PropertyGroup>
    <PackageId Condition="'$(PackageId)' == ''">
      $(MSBuildProjectName)
    </PackageId>

    <Authors Condition="'$(Authors)' == ''">
      Bernardo Estacio Abreu
    </Authors>

    <Company Condition="'$(Company)' == ''">
      ArchenaAI Project
    </Company>

    <Description Condition="'$(Description)' == ''">
      Core module of the ArchenaAI.Common framework.
    </Description>

    <Copyright Condition="'$(Copyright)' == ''">
      Copyright © 2026 Bernardo Estacio Abreu
    </Copyright>

    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">
      https://github.com/bestacio89/ArchenaAI.Common
    </RepositoryUrl>

    <RepositoryType Condition="'$(RepositoryType)' == ''">
      git
    </RepositoryType>

    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">
      MIT
    </PackageLicenseExpression>

    <PackageTags Condition="'$(PackageTags)' == ''">
      ArchenaAI;AI;Semantic;Kernel;Runtime;Orchestration;Agents;Framework
    </PackageTags>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>


  <!-- ============================================================
       README
       ============================================================ -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="$(MSBuildProjectDirectory)\README.md"
          Pack="true"
          PackagePath="" />
  </ItemGroup>

</Project>